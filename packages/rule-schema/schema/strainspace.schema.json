{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrainSpace public document schemas v1",
  "schemas": {
    "counterProfileDocument": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "counterProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "counterProfileId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "replaces": {
                "type": "object",
                "properties": {
                  "factionId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "entityId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "profileId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  }
                },
                "required": [
                  "factionId",
                  "entityId",
                  "profileId"
                ],
                "additionalProperties": false
              },
              "profile": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  },
                  "displayName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "count": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "accuracyRequirement": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 2
                          },
                          {
                            "type": "number",
                            "const": 3
                          },
                          {
                            "type": "number",
                            "const": 4
                          },
                          {
                            "type": "number",
                            "const": 5
                          },
                          {
                            "type": "number",
                            "const": 6
                          }
                        ]
                      },
                      {
                        "type": "string",
                        "const": "impossible"
                      }
                    ]
                  },
                  "power": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "penetration": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "damage": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tags": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    }
                  },
                  "operators": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "operatorId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80,
                          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "modifier",
                            "reroll",
                            "branch",
                            "repeat",
                            "replacement"
                          ]
                        }
                      },
                      "required": [
                        "operatorId",
                        "kind"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "displayName",
                  "count",
                  "accuracyRequirement",
                  "power",
                  "penetration",
                  "damage",
                  "tags",
                  "operators"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "counterProfileId",
              "displayName",
              "replaces",
              "profile"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "counterProfiles"
      ],
      "additionalProperties": false
    },
    "coverageCriterionDocument": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "criterionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "metric": {
          "type": "string",
          "const": "probability-at-least-models-removed"
        },
        "minimumModelsRemoved": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "threshold": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "denominator": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "numerator",
            "denominator"
          ],
          "additionalProperties": false
        },
        "assumptions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "criterionId",
        "displayName",
        "metric",
        "minimumModelsRemoved",
        "threshold",
        "assumptions"
      ],
      "additionalProperties": false
    },
    "proxyFactionDocument": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "factionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "entities": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "cost": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "mobility": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "control": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "defense": {
                "type": "object",
                "properties": {
                  "resilience": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "protectionRequirement": {
                    "anyOf": [
                      {
                        "anyOf": [
                          {
                            "type": "number",
                            "const": 2
                          },
                          {
                            "type": "number",
                            "const": 3
                          },
                          {
                            "type": "number",
                            "const": 4
                          },
                          {
                            "type": "number",
                            "const": 5
                          },
                          {
                            "type": "number",
                            "const": 6
                          }
                        ]
                      },
                      {
                        "type": "string",
                        "const": "impossible"
                      }
                    ]
                  },
                  "health": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "modelCount": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "resilience",
                  "protectionRequirement",
                  "health",
                  "modelCount"
                ],
                "additionalProperties": false
              },
              "attackProfiles": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "count": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "accuracyRequirement": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "number",
                              "const": 2
                            },
                            {
                              "type": "number",
                              "const": 3
                            },
                            {
                              "type": "number",
                              "const": 4
                            },
                            {
                              "type": "number",
                              "const": 5
                            },
                            {
                              "type": "number",
                              "const": 6
                            }
                          ]
                        },
                        {
                          "type": "string",
                          "const": "impossible"
                        }
                      ]
                    },
                    "power": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "penetration": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "damage": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "tags": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80,
                        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                      }
                    },
                    "operators": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "operatorId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80,
                            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                          },
                          "kind": {
                            "type": "string",
                            "enum": [
                              "modifier",
                              "reroll",
                              "branch",
                              "repeat",
                              "replacement"
                            ]
                          }
                        },
                        "required": [
                          "operatorId",
                          "kind"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "displayName",
                    "count",
                    "accuracyRequirement",
                    "power",
                    "penetration",
                    "damage",
                    "tags",
                    "operators"
                  ],
                  "additionalProperties": false
                }
              },
              "tags": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                }
              }
            },
            "required": [
              "id",
              "displayName",
              "cost",
              "mobility",
              "control",
              "defense",
              "attackProfiles",
              "tags"
            ],
            "additionalProperties": false
          }
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "schemaVersion",
        "factionId",
        "displayName",
        "description",
        "entities"
      ],
      "additionalProperties": false
    },
    "thresholdMapDocument": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "mapId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "relationId": {
          "type": "string",
          "const": "power-resilience-v1"
        },
        "sourceSpace": {
          "type": "string",
          "minLength": 1
        },
        "targetSpace": {
          "type": "string",
          "minLength": 1
        },
        "operatorVersion": {
          "type": "string",
          "minLength": 1
        },
        "invariantIds": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          }
        },
        "regions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "regionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "minimumRatio": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "maximumRatio": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "numerator": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      "denominator": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "numerator",
                      "denominator"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "minimumInclusive": {
                "type": "boolean"
              },
              "maximumInclusive": {
                "type": "boolean"
              },
              "requirement": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "number",
                        "const": 2
                      },
                      {
                        "type": "number",
                        "const": 3
                      },
                      {
                        "type": "number",
                        "const": 4
                      },
                      {
                        "type": "number",
                        "const": 5
                      },
                      {
                        "type": "number",
                        "const": 6
                      }
                    ]
                  },
                  {
                    "type": "string",
                    "const": "impossible"
                  }
                ]
              }
            },
            "required": [
              "regionId",
              "label",
              "minimumRatio",
              "maximumRatio",
              "minimumInclusive",
              "maximumInclusive",
              "requirement"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "mapId",
        "displayName",
        "relationId",
        "sourceSpace",
        "targetSpace",
        "operatorVersion",
        "invariantIds",
        "regions"
      ],
      "additionalProperties": false
    }
  }
}
