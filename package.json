{
  "name": "strainspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deterministic geometric reasoning for generic tabletop force analysis.",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "corepack pnpm@11.13.0 -r --if-present build",
    "check": "corepack pnpm@11.13.0 format:check && corepack pnpm@11.13.0 lint && corepack pnpm@11.13.0 typecheck && corepack pnpm@11.13.0 test:unit && corepack pnpm@11.13.0 build && corepack pnpm@11.13.0 fixtures:scan",
    "fixtures:scan": "tsx scripts/scan-fixtures.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "schema:export": "corepack pnpm@11.13.0 --filter @strainspace/rule-schema schema:export",
    "test": "corepack pnpm@11.13.0 test:unit",
    "test:unit": "corepack pnpm@11.13.0 -r --if-present test:unit",
    "typecheck": "corepack pnpm@11.13.0 -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.0.13"
  }
}
